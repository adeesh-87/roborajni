#!/usr/bin/env python3
"""mb — minimal message board for a team of agents. Pull-based, email-like.

Storage: single SQLite file (WAL mode) at ~/.mb/board.db (override with MB_DB).
No daemon: every invocation opens the DB, does one operation, exits.
"""
import argparse
import os
import pathlib
import secrets
import sqlite3
import sys
import time

DB_PATH = pathlib.Path(os.environ.get("MB_DB", pathlib.Path.home() / ".mb" / "board.db"))
LOBBY = "lobby"

SCHEMA = """
CREATE TABLE IF NOT EXISTS messages (
  seq        INTEGER PRIMARY KEY AUTOINCREMENT,
  topic      TEXT NOT NULL,
  sender     TEXT NOT NULL,
  body       TEXT NOT NULL,
  reply_to   INTEGER REFERENCES messages(seq),
  created_at INTEGER NOT NULL
);
CREATE TABLE IF NOT EXISTS subscriptions (
  agent TEXT NOT NULL,
  topic TEXT NOT NULL,
  PRIMARY KEY (agent, topic)
);
CREATE TABLE IF NOT EXISTS cursors (
  agent    TEXT PRIMARY KEY,
  last_seq INTEGER NOT NULL DEFAULT 0
);
CREATE TABLE IF NOT EXISTS teams (
  id         TEXT PRIMARY KEY,
  label      TEXT,
  roles      TEXT NOT NULL,
  task       TEXT,
  status     TEXT NOT NULL,
  start_seq  INTEGER NOT NULL,
  created_at INTEGER NOT NULL
);
CREATE TABLE IF NOT EXISTS members (
  team      TEXT NOT NULL REFERENCES teams(id),
  role      TEXT NOT NULL,
  agent     TEXT NOT NULL UNIQUE,
  joined_at INTEGER NOT NULL,
  PRIMARY KEY (team, role)
);
"""


def die(msg):
    print(f"mb: error: {msg}", file=sys.stderr)
    sys.exit(1)


def now_ms():
    return int(time.time() * 1000)


def connect():
    DB_PATH.parent.mkdir(parents=True, exist_ok=True)
    con = sqlite3.connect(DB_PATH, timeout=30, isolation_level=None)
    con.execute("PRAGMA journal_mode=WAL")
    con.execute("PRAGMA busy_timeout=30000")
    con.executescript(SCHEMA)
    return con


def _post(con, topic, sender, body, reply_to=None):
    cur = con.execute(
        "INSERT INTO messages (topic, sender, body, reply_to, created_at) VALUES (?, ?, ?, ?, ?)",
        (topic, sender, body, reply_to, now_ms()),
    )
    return cur.lastrowid


def _set_cursor(con, agent, seq):
    con.execute(
        "INSERT INTO cursors (agent, last_seq) VALUES (?, ?) "
        "ON CONFLICT(agent) DO UPDATE SET last_seq=excluded.last_seq",
        (agent, seq),
    )


def _team_of(con, agent):
    row = con.execute("SELECT team FROM members WHERE agent=?", (agent,)).fetchone()
    return row[0] if row else None


def cmd_pub(args):
    con = connect()
    if args.topic.startswith("team/"):
        team = args.topic[len("team/"):]
        if not con.execute("SELECT 1 FROM members WHERE team=? AND agent=?", (team, args.sender)).fetchone():
            die(f"'{args.sender}' is not a member of team {team}; team channels are private")
    seq = _post(con, args.topic, args.sender, args.body, args.reply_to)
    print(f"published seq={seq} topic={args.topic}")


def cmd_say(args):
    con = connect()
    team = _team_of(con, args.agent)
    if not team:
        die(f"'{args.agent}' is not in any team; run `mb team join` first and use the agent id it prints")
    seq = _post(con, f"team/{team}", args.agent, args.body, args.reply_to)
    print(f"published seq={seq} topic=team/{team}")


def cmd_sub(args):
    con = connect()
    if args.topic.startswith("team/"):
        team = args.topic[len("team/"):]
        if not con.execute("SELECT 1 FROM members WHERE team=? AND agent=?", (team, args.agent)).fetchone():
            die(f"'{args.agent}' is not a member of team {team}; join with `mb team join`")
    con.execute("INSERT OR IGNORE INTO subscriptions (agent, topic) VALUES (?, ?)", (args.agent, args.topic))
    print(f"{args.agent} subscribed to {args.topic}")


def _inbox_topics(con, agent):
    topics = [f"agent/{agent}", "all"]
    topics += [r[0] for r in con.execute("SELECT topic FROM subscriptions WHERE agent=?", (agent,))]
    return topics


def _unread(con, agent):
    row = con.execute("SELECT last_seq FROM cursors WHERE agent=?", (agent,)).fetchone()
    last_seq = row[0] if row else 0
    topics = _inbox_topics(con, agent)
    placeholders = ",".join("?" * len(topics))
    return con.execute(
        f"SELECT seq, topic, sender, body, reply_to FROM messages "
        f"WHERE topic IN ({placeholders}) AND seq > ? AND sender != ? ORDER BY seq",
        (*topics, last_seq, agent),
    ).fetchall()


def cmd_inbox(args):
    con = connect()
    deadline = time.time() + args.wait
    rows = _unread(con, args.agent)
    while not rows and time.time() < deadline:
        time.sleep(2)
        rows = _unread(con, args.agent)
    if not rows:
        print("(no new messages)")
        return
    for seq, topic, sender, body, reply_to in rows:
        reply = f" (reply_to={reply_to})" if reply_to else ""
        print(f"[{seq}] {topic} <{sender}>{reply}: {body}")
    if not args.peek:
        _set_cursor(con, args.agent, rows[-1][0])


def cmd_ack(args):
    con = connect()
    _set_cursor(con, args.agent, args.seq)
    print(f"{args.agent} cursor set to {args.seq}")


def cmd_tail(args):
    con = connect()
    if args.topic:
        rows = con.execute(
            "SELECT seq, topic, sender, body FROM messages WHERE topic=? ORDER BY seq DESC LIMIT ?",
            (args.topic, args.n),
        ).fetchall()
    else:
        rows = con.execute(
            "SELECT seq, topic, sender, body FROM messages ORDER BY seq DESC LIMIT ?",
            (args.n,),
        ).fetchall()
    for seq, topic, sender, body in reversed(rows):
        print(f"[{seq}] {topic} <{sender}>: {body}")


def _roster(con, team):
    return dict(con.execute("SELECT role, agent FROM members WHERE team=?", (team,)).fetchall())


def _describe(con, team, agent=None):
    tid, label, roles, task, status = con.execute(
        "SELECT id, label, roles, task, status FROM teams WHERE id=?", (team,)
    ).fetchone()
    roster = _roster(con, tid)
    missing = [r for r in roles.split(",") if r not in roster]
    lines = []
    if agent:
        lines.append(f"YOUR AGENT ID: {agent}   <- use it as --agent / --sender in EVERY mb command")
    lines += [
        f"team:          {tid}" + (f" (label: {label})" if label else ""),
        f"team channel:  team/{tid}   (post with: mb say \"<TYPE>: ...\" --agent {agent or '<your id>'})",
        f"task:          {task or '(none given)'}",
        "roster:        " + " ; ".join(f"{r} -> {roster.get(r, '(open)')}" for r in roles.split(",")),
        f"status:        {status}" + (f" (waiting for: {', '.join(missing)})" if missing and status == "forming" else ""),
    ]
    return "\n".join(lines)


def cmd_team_join(args):
    roles = sorted({r.strip() for r in args.roles.split(",") if r.strip()})
    if args.role not in roles:
        die(f"role '{args.role}' is not in team roles {roles}")
    roles_key = ",".join(roles)
    task = args.task.strip() if args.task else None
    con = connect()
    con.execute("BEGIN IMMEDIATE")
    try:
        cutoff = now_ms() - args.ttl * 60_000
        for (stale,) in con.execute(
            "SELECT id FROM teams WHERE status='forming' AND created_at < ?", (cutoff,)
        ).fetchall():
            con.execute("UPDATE teams SET status='abandoned' WHERE id=?", (stale,))
            _post(con, LOBBY, "mb", f"ABANDONED: team {stale} never filled all roles")

        row = con.execute(
            "SELECT id FROM teams WHERE status='forming' AND roles=? AND label IS ? "
            "AND id NOT IN (SELECT team FROM members WHERE role=?) ORDER BY created_at LIMIT 1",
            (roles_key, args.label, args.role),
        ).fetchone()
        if row:
            team = row[0]
        else:
            team = f"t-{secrets.token_hex(3)}"
            start_seq = con.execute("SELECT COALESCE(MAX(seq), 0) FROM messages").fetchone()[0]
            con.execute(
                "INSERT INTO teams (id, label, roles, task, status, start_seq, created_at) "
                "VALUES (?, ?, ?, ?, 'forming', ?, ?)",
                (team, args.label, roles_key, task, start_seq, now_ms()),
            )
            _post(con, LOBBY, "mb", f"OPEN: team {team} roles={roles_key}"
                  + (f" label={args.label}" if args.label else "") + (f" task={task}" if task else ""))

        start_seq, team_task = con.execute("SELECT start_seq, task FROM teams WHERE id=?", (team,)).fetchone()
        warning = None
        if task and not team_task:
            con.execute("UPDATE teams SET task=? WHERE id=?", (task, team))
        elif task and team_task and task != team_task:
            warning = "WARNING: the task you were given differs from the team's task. The team task (below) is authoritative."

        agent = f"{args.role}@{team}"
        con.execute(
            "INSERT INTO members (team, role, agent, joined_at) VALUES (?, ?, ?, ?)",
            (team, args.role, agent, now_ms()),
        )
        con.execute("INSERT OR IGNORE INTO subscriptions (agent, topic) VALUES (?, ?)", (agent, f"team/{team}"))
        _set_cursor(con, agent, start_seq)
        _post(con, f"team/{team}", agent, f"JOIN: {agent} (role {args.role})")

        roster = _roster(con, team)
        if all(r in roster for r in roles):
            con.execute("UPDATE teams SET status='formed' WHERE id=?", (team,))
            final_task = con.execute("SELECT task FROM teams WHERE id=?", (team,)).fetchone()[0]
            body = f"FORMED: team {team}\ntask: {final_task or '(none given)'}\nroster:\n" + "\n".join(
                f"- {r}: {roster[r]}" for r in roles
            )
            _post(con, f"team/{team}", "mb", body)
            _post(con, LOBBY, "mb", f"FORMED: team {team} " + " ".join(roster[r] for r in roles))
        con.execute("COMMIT")
    except BaseException:
        con.execute("ROLLBACK")
        raise

    if warning:
        print(warning)
    print(_describe(con, team, agent))
    status = con.execute("SELECT status FROM teams WHERE id=?", (team,)).fetchone()[0]
    if status == "forming":
        print(f"\nNext: wait for the FORMED message: mb inbox --agent {agent} --wait 90")
    else:
        print(f"\nTeam is complete. Read the FORMED message: mb inbox --agent {agent}")


def cmd_team_show(args):
    con = connect()
    team = _team_of(con, args.agent)
    if not team:
        die(f"'{args.agent}' is not in any team")
    print(_describe(con, team, args.agent))


def cmd_team_list(args):
    con = connect()
    rows = con.execute(
        "SELECT id, label, status, roles, task FROM teams ORDER BY created_at DESC LIMIT ?", (args.n,)
    ).fetchall()
    if not rows:
        print("(no teams)")
    for tid, label, status, roles, task in rows:
        roster = _roster(con, tid)
        members = " ".join(roster.get(r, f"{r}:(open)") for r in roles.split(","))
        print(f"{tid} [{status}]" + (f" label={label}" if label else "") + f"  {members}"
              + (f"  task={task[:60]}" if task else ""))


def main():
    p = argparse.ArgumentParser(prog="mb")
    sub = p.add_subparsers(dest="cmd", required=True)

    pp = sub.add_parser("pub", help="publish a message to a topic")
    pp.add_argument("topic")
    pp.add_argument("body")
    pp.add_argument("--sender", required=True)
    pp.add_argument("--reply-to", type=int, default=None, dest="reply_to")
    pp.set_defaults(func=cmd_pub)

    yp = sub.add_parser("say", help="publish to your own team's channel")
    yp.add_argument("body")
    yp.add_argument("--agent", required=True)
    yp.add_argument("--reply-to", type=int, default=None, dest="reply_to")
    yp.set_defaults(func=cmd_say)

    sp = sub.add_parser("sub", help="subscribe an agent to a topic")
    sp.add_argument("topic")
    sp.add_argument("--agent", required=True)
    sp.set_defaults(func=cmd_sub)

    ip = sub.add_parser("inbox", help="read (and consume) unread messages for an agent")
    ip.add_argument("--agent", required=True)
    ip.add_argument("--peek", action="store_true", help="don't advance the read cursor")
    ip.add_argument("--wait", type=int, default=0, metavar="SECONDS", help="block up to SECONDS for new mail")
    ip.set_defaults(func=cmd_inbox)

    ap = sub.add_parser("ack", help="manually set an agent's read cursor")
    ap.add_argument("agent")
    ap.add_argument("seq", type=int)
    ap.set_defaults(func=cmd_ack)

    tp = sub.add_parser("tail", help="debug: show recent messages regardless of cursor")
    tp.add_argument("--topic", default=None)
    tp.add_argument("-n", type=int, default=20)
    tp.set_defaults(func=cmd_tail)

    team = sub.add_parser("team", help="team rendezvous").add_subparsers(dest="team_cmd", required=True)

    jp = team.add_parser("join", help="join (or start) a team that needs your role")
    jp.add_argument("--role", required=True)
    jp.add_argument("--roles", default="proposer,critic", help="full team composition, comma-separated")
    jp.add_argument("--label", default=None, help="only team up with agents using the same label")
    jp.add_argument("--task", default=None)
    jp.add_argument("--ttl", type=int, default=30, metavar="MINUTES", help="abandon teams still forming after this long")
    jp.set_defaults(func=cmd_team_join)

    shp = team.add_parser("show", help="show your team, task and roster")
    shp.add_argument("--agent", required=True)
    shp.set_defaults(func=cmd_team_show)

    lp = team.add_parser("list", help="list recent teams")
    lp.add_argument("-n", type=int, default=20)
    lp.set_defaults(func=cmd_team_list)

    args = p.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
